# Optional local Hugging Face checkpoint. Leave blank until a checkpoint and its license are approved.
AMIN_MODEL_ID=
# Security default: use weights already staged on the host; set false only for an approved download.
AMIN_MODEL_LOCAL_ONLY=true
AMIN_DEVICE_MAP=auto
AMIN_MAX_NEW_TOKENS=2048
AMIN_MAX_INPUT_TOKENS=8192
AMIN_TEMPERATURE=0.2

# Optional Tesseract OCR settings; host must install Tesseract and ara+eng traineddata.
TESSERACT_CMD=
AMIN_OCR_LANGUAGES=ara+eng
