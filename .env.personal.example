# Copy this file to .env. Generate both secrets independently; never commit .env.
AMIN_API_KEY=REPLACE_WITH_A_LONG_RANDOM_PRIVATE_SECRET
AMIN_MODEL_SERVER_KEY=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET

# Personal private-server baseline candidate: Gemma 4 31B instruction-tuned QAT.
AMIN_MODEL_ID=google/gemma-4-31B-it-qat-w4a16-ct
AMIN_MODEL_NAME=amin-gemma-legal
AMIN_MAX_MODEL_LEN=16384
AMIN_MAX_NEW_TOKENS=4096
AMIN_TEMPERATURE=0.2
AMIN_INFERENCE_TIMEOUT_SECONDS=900
AMIN_API_PORT=8000

# Optional Hugging Face token only if the selected checkpoint requires authenticated access.
HF_TOKEN=
